<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>ioBroker_NewGen</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.3.0-beta0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>beta0.3.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RSEV.Utilities">
      <HintPath>libs\RSEV.Utilities.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**\*" />
    <None Update="Adapters\custom\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Localization\*.json" LogicalName="Localization.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Legacy\dist\adapter-core\**" Exclude="Legacy\dist\adapter-core\**\*.tgz" Link="Legacy\adapter-core\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.*" />
  </ItemGroup>

  <!-- Moves all dependency DLLs into <output>\lib; resolved at runtime by Startup\DependencyResolver.cs -->
  <Target Name="MoveDependenciesToLib" AfterTargets="Build;CopyFilesToOutputDirectory" Condition="'$(OutDir)' != ''">
    <ItemGroup>
      <DependencyDll Include="$(OutDir)*.dll" Exclude="$(OutDir)$(TargetFileName)" />
    </ItemGroup>
    <Copy SourceFiles="@(DependencyDll)" DestinationFolder="$(OutDir)lib" SkipUnchangedFiles="true" />
    <Delete Files="@(DependencyDll)" />
  </Target>

  <Target Name="MoveDependenciesToLibForPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishDependencyDll Include="$(PublishDir)*.dll" Exclude="$(PublishDir)$(TargetFileName)" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishDependencyDll)" DestinationFolder="$(PublishDir)lib" SkipUnchangedFiles="true" />
    <Delete Files="@(PublishDependencyDll)" />
  </Target>

  <Target Name="CreateLogDirectory" AfterTargets="Build;CopyFilesToOutputDirectory" Condition="'$(OutDir)' != ''">
    <MakeDir Directories="$(OutDir)log" />
  </Target>

  <Target Name="CreateLogDirectoryForPublish" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)log" />
  </Target>

  <Target Name="BuildExternalAdapterAssembliesForPublish" BeforeTargets="Publish">
    <MSBuild Projects="@(ExternalAdapterProject)" Targets="Build" BuildInParallel="true" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" />
  </Target>

  <Target Name="CopyExternalAdapterAssembliesForPublish" AfterTargets="Publish">
    <ItemGroup>
      <CustomAdapterFile Include="$(MSBuildProjectDirectory)\Adapters\custom\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(CustomAdapterFile)" DestinationFiles="@(CustomAdapterFile->'$(PublishDir)Adapters\custom\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyRuntimeArtifactsForPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Doku\config.template.toml" DestinationFiles="$(PublishDir)config.toml" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(PublishDir)snapshot.jsonl" Lines="" Overwrite="true" Encoding="UTF-8" />
  </Target>

</Project>
